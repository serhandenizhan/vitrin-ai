# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# .env asla commit edilmez.

MAX_FILE_SIZE_MB=20
REMBG_MODEL_NAME=birefnet-general
# Ölçülen 12-14GB RAM bütçesi (bkz. kök CLAUDE.md) nedeniyle varsayılan olarak
# tek seferde bir inference'a izin verilir; bu, sürece/worker'a özgüdür.
MAX_CONCURRENT_INFERENCES=1
# Decompression-bomb tarzı (küçük byte, devasa piksel sayımı) görselleri
# reddetmek için piksel sınırı — PIL'in kendi global'ine güvenilmiyor.
MAX_IMAGE_PIXELS=40000000
# Boş bırakılırsa MAX_FILE_SIZE_MB + 64KB (multipart zarf payı) olarak
# otomatik hesaplanır. Uzun dosya adı/ek form alanı kullanan istemciler için
# gerekirse burada açıkça override edilebilir (bayt cinsinden).
# MAX_REQUEST_BODY_BYTES=

# Faz 3: arka plan kütüphanesi.
# Yerel Postgres için docker-compose.yml'deki varsayılanlarla eşleşir.
DATABASE_URL=postgresql+asyncpg://vitrin_ai:change_me_locally@localhost:5432/vitrin_ai
# Faz 4: Supabase Auth. Proje adresi (Dashboard > Project Settings > API).
# Boş bırakılırsa oturum gerektiren endpoint'ler (projeler, admin) 503 döner.
# Faz 3'teki ADMIN_SECRET kaldırıldı — yönetici yetkisi artık admin_users
# tablosundan geliyor (bkz. backend/README.md "Kimlik doğrulama").
SUPABASE_URL=
# Yalnızca imzalama anahtarlarına (JWKS) GEÇMEMİŞ eski projeler için. Yeni
# projelerde boş kalmalı; Supabase HS256'yı üretim için önermiyor.
SUPABASE_LEGACY_JWT_SECRET=
# Supabase GİZLİ sunucu anahtarı (Dashboard > Project Settings > API Keys >
# Secret keys, "sb_secret_..."). Yalnızca hesap silme için. RLS'i atlar:
# frontend'e asla yazılmaz, paylaşılmaz. Boşsa hesap silme 503 döner.
SUPABASE_SECRET_KEY=
# Virgülle ayrılmış tarayıcı origin'leri. '*' kabul edilmez; production alan
# adı belli olunca eklenmeli (bkz. kök CLAUDE.md açık takip maddeleri).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proje (geçmiş çalışma) görsellerinin imzalı URL süresi (saniye).
PROJECT_URL_EXPIRY_SECONDS=3600
# Cloudflare R2 kimlik bilgileri (R2 dashboard > Manage API tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# GET /api/backgrounds içindeki presigned URL'lerin geçerlilik süresi (saniye).
BACKGROUND_URL_EXPIRY_SECONDS=3600

