# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# .env asla commit edilmez.

MAX_FILE_SIZE_MB=20
REMBG_MODEL_NAME=birefnet-general
# Ölçülen 12-14GB RAM bütçesi (bkz. kök CLAUDE.md) nedeniyle varsayılan olarak
# tek seferde bir inference'a izin verilir; bu, sürece/worker'a özgüdür.
MAX_CONCURRENT_INFERENCES=1
# Decompression-bomb tarzı (küçük byte, devasa piksel sayımı) görselleri
# reddetmek için piksel sınırı — PIL'in kendi global'ine güvenilmiyor.
MAX_IMAGE_PIXELS=40000000
# Boş bırakılırsa MAX_FILE_SIZE_MB + 64KB (multipart zarf payı) olarak
# otomatik hesaplanır. Uzun dosya adı/ek form alanı kullanan istemciler için
# gerekirse burada açıkça override edilebilir (bayt cinsinden).
# MAX_REQUEST_BODY_BYTES=
# Upload endpoint'lerinde kayan pencere hizi: once IP (oturumsuz/gecersiz
# token), dogrulama sonrasinda kullanici. Tum kontroller govdeden once.
# Sayac Redis'te tutuluyor (asagidaki REDIS_URL) — coklu worker/instance
# ayni siniri paylasir.
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_IP_RATE_LIMIT_REQUESTS=120
UPLOAD_USER_RATE_LIMIT_REQUESTS=30
# Yerel Redis için docker-compose.yml'deki varsayılanlarla eşleşir.
REDIS_URL=redis://localhost:6379/0

# Faz 3: arka plan kütüphanesi.
# Yerel Postgres için docker-compose.yml'deki varsayılanlarla eşleşir.
DATABASE_URL=postgresql+asyncpg://vitrin_ai:change_me_locally@localhost:5432/vitrin_ai
# Faz 4: Supabase Auth. Proje adresi (Dashboard > Project Settings > API).
# Boş bırakılırsa oturum gerektiren endpoint'ler (projeler, admin) 503 döner.
# Faz 3'teki ADMIN_SECRET kaldırıldı — yönetici yetkisi artık admin_users
# tablosundan geliyor (bkz. backend/README.md "Kimlik doğrulama").
SUPABASE_URL=
# Yalnızca imzalama anahtarlarına (JWKS) GEÇMEMİŞ eski projeler için. Yeni
# projelerde boş kalmalı; Supabase HS256'yı üretim için önermiyor.
SUPABASE_LEGACY_JWT_SECRET=
# Supabase GİZLİ sunucu anahtarı (Dashboard > Project Settings > API Keys >
# Secret keys, "sb_secret_..."). Yalnızca hesap silme için. RLS'i atlar:
# frontend'e asla yazılmaz, paylaşılmaz. Boşsa hesap silme 503 döner.
SUPABASE_SECRET_KEY=
# Virgülle ayrılmış tarayıcı origin'leri. '*' kabul edilmez; production alan
# adı belli olunca eklenmeli (bkz. kök CLAUDE.md açık takip maddeleri).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proje (geçmiş çalışma) görsellerinin imzalı URL süresi (saniye).
PROJECT_URL_EXPIRY_SECONDS=3600
# Cloudflare R2 kimlik bilgileri (R2 dashboard > Manage API tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# DIKKAT: arka plan kaldirma, basarili sonucu gecici bir R2 nesnesi olarak
# saklamadan krediyi tuketmiyor. R2 ayarlari eksikse uc nokta inference'a hic
# girmeden 503 `result_storage_unavailable` doner — yerel gelistirmede de
# gerekli (yalniz arayuz icin frontend/.env.local'de USE_MOCK_BACKEND=true).
R2_BUCKET_NAME=
# GET /api/backgrounds içindeki presigned URL'lerin geçerlilik süresi (saniye).
BACKGROUND_URL_EXPIRY_SECONDS=3600

# Faz 5: varsayılan kapalı. Gerçek değerler yalnız sunucu ortamında tutulur.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
BILLING_CHECKOUT_ENABLED=false
BILLING_PRODUCTION_VERIFIED=false
BILLING_CALLBACK_URL=
BILLING_FRONTEND_URL=http://localhost:3000
BILLING_LEGAL_APPROVED=false
BILLING_INVOICE_PROCESS_READY=false
BILLING_SALES_DOCUMENT_VERSION=
BILLING_SALES_DOCUMENT_TEXT=
BILLING_PRE_INFORMATION_TEXT=

# Ters proxy (nginx/Caddy) arkasinda gercek istemci IP'si. Hiz siniri kovalari
# buna gore ayriliyor. BOSKEN `X-Forwarded-For` hic okunmaz — sahte basligin
# kovayi degistirmesi boylece engellenir. Uretimde yalnizca proxy'nin kendi
# adresi yazilir; uvicorn'un `--forwarded-allow-ips` degeriyle AYNI liste olmali
# (bkz. docs/billing-runbook.md).
TRUSTED_PROXY_IPS=

# "Odemeniz alinamadi, kartinizi guncelleyin" e-postasi (Resend HTTP API).
# UCRETLI CHECKOUT'UN ACILIS KOSULU: ikisi bos iken BILLING_CHECKOUT_ENABLED
# true olsa bile satin alma 503 doner — kullaniciya vaat edilen 3 gunluk grace
# penceresinin tek uyarisi bu e-posta. Gonderim yine de yapilamazsa sessiz
# kalmaz, `billing_alerts` tablosuna `dunning_email_not_sent` yazilir.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
BILLING_EMAIL_FROM=
