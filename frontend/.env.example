# Bu dosyayı .env.local olarak kopyalayın: cp .env.example .env.local
# .env.local asla commit edilmez.

# FastAPI servisinin adresi. Tarayıcı buraya doğrudan bağlanmaz; istek
# Next.js route handler'ı (src/app/api/remove-background/route.ts) üzerinden
# vekillenir.
BACKEND_URL=http://localhost:8000

# Demo (mock) modu: true iken backend hiç çağrılmaz, sabit bir örnek kesim
# döner ve arayüz sonucu açıkça "Demo modu" olarak işaretler.
#
# DİKKAT: bu değer true kalırsa gerçek backend ayakta olsa bile arayüz hep
# aynı örnek görseli gösterir. Gerçek uçtan uca test için false yapın.
USE_MOCK_BACKEND=true

# Faz 4: Supabase Auth. Dashboard > Project Settings > API Keys.
# Ikisi de tarayiciya gidecek sekilde tasarlandi (NEXT_PUBLIC_); veriyi koruyan
# tablolardaki RLS. Publishable key "sb_publishable_..." ile baslar (eski adi
# "anon public"). service_role / secret anahtar buraya ASLA yazilmaz.
# Bos birakilirsa site calisir ama giris yapilamaz.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Yasal sayfalarda yayinlanacak gercek/tuzel kisi unvani ve basvuru e-postasi.
NEXT_PUBLIC_DATA_CONTROLLER_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
# Vercel disi production deploy'unda bu degeri production yapin; eksik yasal
# kimlik/iletisim bilgisiyle build bilincli olarak durur.
VITRIN_DEPLOY_ENV=development

# Baskiya uygun (CMYK) donusum icin hedef baski kosulunun ICC profili.
# Ayarlanmazsa /api/cmyk acik bir mesajla 503 doner (sessizce yanlis renk
# uretmektense reddetmek dogru).
# Kullanilan profil: ECI "PSO Coated v3" (eci.org -> pso-coated_v3.zip ->
# PSOcoated_v3.icc). DEPOYA KONMAZ: lisansi gommeye izin veriyor, dagitmaya
# izin vermiyor. Depo DISINA indirip tam yolunu yazin.
# CMYK_ICC_PATH=C:/yol/vitrin-ai-baski/PSOcoated_v3.icc

# Gelistirme sunucusunu ayni agdaki bir telefondan acmak icin bilgisayarin
# yerel IP'si (virgulle birden fazla). Next.js 16 aksi halde bu istekleri
# engelliyor ve sayfa etkilesimsiz kaliyor. Yalnizca `npm run dev` icin.
# DEV_ALLOWED_ORIGINS=192.168.1.10
